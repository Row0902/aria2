# .envrc — aria2 Python SDK
# Automatically loaded by direnv when entering this directory.
layout uv
# Version controlled — share project environment config.
# Secrets go in .env (gitignored), not here.

# ── Strict mode ──────────────────────────────────────
# Fail on errors, undefined vars, and pipe failures
strict_env

# ── PYTHONPATH for development imports ───────────────
# Allows `from aria2 import Aria2Client` when running
# scripts directly without uv run or pip install -e
PATH_add "src/"
export PYTHONPATH="${PWD}/src${PYTHONPATH:+:$PYTHONPATH}"

# ── SDK defaults (overridable by .env) ───────────────
# export ARIA2_HOST="localhost"
# export ARIA2_PORT="6800"
# export ARIA2_DEBUG="1"

# ── Local secrets (not versioned) ────────────────────
dotenv_if_exists

# ── Status ───────────────────────────────────────────
log_status "aria2 SDK — PYTHONPATH+=src/"
